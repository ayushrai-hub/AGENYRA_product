# Server-only. Never prefix these with NEXT_PUBLIC_.

# Supabase project that stores the waitlist.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Enables GET /api/admin/waitlist/export. At least 24 characters.
# Leave empty and the export route returns 404.
WAITLIST_EXPORT_TOKEN=

# Salt for hashing client IPs used in rate limiting.
WAITLIST_IP_SALT=
